# Server
PORT=8000
APP_URL=http://localhost:8000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hks_billing
# Uncomment if your provider requires TLS:
# PGSSLMODE=require

# Admin API access (used by admin.html)
ADMIN_TOKEN=change-this-admin-token

# Monthly membership fee, in paise (5000 = Rs. 50)
MONTHLY_FEE_PAISE=5000
CURRENCY=INR

# Razorpay (test keys are fine for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended. If omitted, key_secret is used for webhook verification.
RAZORPAY_WEBHOOK_SECRET=

# Manual UPI details shown on the pay page and encoded in the QR code
UPI_ID=harithakarmasena@upi
UPI_NAME=Haritha Karma Sena
