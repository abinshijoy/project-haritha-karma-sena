# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haritha_karma_sena?schema=public"

# Auth
# Use a long random secret in real deployments (at least 32 chars).
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
OTP_TTL_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# CORS - comma-separated origins, or * for development only
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# OTP delivery provider: "console" logs OTP to server terminal (development only)
OTP_PROVIDER="console"
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID=""

# Seed admin (used by npm run prisma:seed)
SEED_ADMIN_PHONE="+910000000000"
SEED_ADMIN_NAME="System Admin"
